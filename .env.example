BOT_TOKEN=
ADMIN_ID=

# Calendar sync
CALENDAR_TIMEZONE=Europe/Moscow
CALENDAR_SYNC_TIMEOUT=8

# Shared Google service account JSON. Keep it as one line in Railway variables.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Backward-compatible DIKIDI / Massage Future calendar id.
GOOGLE_CALENDAR_ID=

# Uni-Q calendar source. Use Google Calendar or JSON feed.
UNIQ_GOOGLE_SERVICE_ACCOUNT_JSON=
UNIQ_GOOGLE_CALENDAR_ID=
UNIQ_CALENDAR_URL=
UNIQ_CALENDAR_TOKEN=
UNIQ_REQUIRED_RESOURCES=кушетка,душ

# DIKIDI / Massage Future calendar source. Use Google Calendar or JSON feed.
DIKIDI_GOOGLE_SERVICE_ACCOUNT_JSON=
DIKIDI_GOOGLE_CALENDAR_ID=
DIKIDI_CALENDAR_URL=
DIKIDI_CALENDAR_TOKEN=
